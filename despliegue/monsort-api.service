[Unit]
Description=Monsort API (FastAPI + uvicorn)
Documentation=https://github.com/DeigoRomero/Monsort
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=monsort
Group=monsort
WorkingDirectory=/srv/monsort/ProyectoMonsort/Backend

# El .env se lee desde aqui. Permisos 600, dueño monsort.
EnvironmentFile=/srv/monsort/ProyectoMonsort/Backend/.env
Environment="PYTHONUNBUFFERED=1"

# --workers 1 NO es negociable.
# APScheduler vive dentro del proceso de FastAPI. Con N workers habria
# N schedulers disparando los jobs en paralelo: correos duplicados,
# consultas al SAT concurrentes (prohibido), y solicitudes de descarga
# masiva repetidas que queman la cuota de por vida del RFC.
#
# --root-path /api tampoco es negociable. nginx recorta el prefijo /api antes
# de pasar la peticion a uvicorn, asi que sin esto FastAPI arma sus propios
# redirects (el 307 por barra final, el callback de OAuth) sin el prefijo y
# apuntan fuera del sitio. Se verifica con:
#     curl -IL https://facturas.grupomonsort.com/api/health
# debe redirigir a /api/health/ y no a /health/.
ExecStart=/srv/monsort/.venv/bin/uvicorn \
    main:aplicacion \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --root-path /api \
    --log-level info

Restart=always
RestartSec=5

# Espera a que termine el ciclo de correos en curso antes de matar.
KillSignal=SIGINT
TimeoutStopSec=60

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/monsort

StandardOutput=journal
StandardError=journal
SyslogIdentifier=monsort-api

[Install]
WantedBy=multi-user.target
